# Copy this file to .env.local and fill in values from your free Supabase project
# (Project Settings -> API). See SETUP.md for the full free setup guide.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for real payments and for the Stripe webhook to write progress
# server-side — from the same free Supabase project, Project Settings -> API
# -> "service_role" secret. NEVER expose this to the browser (no NEXT_PUBLIC_
# prefix, on purpose) — it bypasses all row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: powers the CodeBuddy AI mentor (Pro-only). Free API key from
# https://aistudio.google.com — no card required. Leave blank to disable;
# the mentor panel will just show "isn't configured yet" instead of erroring.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional: real payments via Stripe (Stripe itself is free to sign up for —
# they only take a cut once you actually have paying customers). Leave blank
# to keep using the manual admin-grant paywall; the Upgrade buttons will
# just redirect back to pricing instead of erroring. See SETUP.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
